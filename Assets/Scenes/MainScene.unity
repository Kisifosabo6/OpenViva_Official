    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\tInstructions:\n1.) Drop wild wheat into mortar\n2.) Grind into flour
    with pestle\n3.) Pour 10 flour into mixing bowl\n4.) Crack 4 eggs into mixing
    bowl\n5.) Mix batter with spoon\n6.) Fill black pot with water\n7.) Drop fruit
    into the water pot to make jelly\n8.) Scoop out jelly with spoon and place on
    pastry\n9.) Place pastry into oven until it is finished!"
